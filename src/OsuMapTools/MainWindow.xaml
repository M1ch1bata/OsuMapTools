<Window x:Class="OsuMapTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsuMapTools"
        Icon="pack://application:,,,/assets/osu.ico"
        Width="640" Height="480"
        ResizeMode="CanMinimize"
        Background="{StaticResource Bg}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- song banner -->
        <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="76" Height="76" CornerRadius="6" Background="#111"
                        ClipToBounds="True">
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="未选择谱面" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" Text="" FontSize="12" Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <Border Background="{StaticResource Accent}" CornerRadius="6" Padding="7,2"
                            HorizontalAlignment="Left" Margin="0,4,0,0">
                        <TextBlock x:Name="VersionText" Text="" FontSize="10" Foreground="#1a0f1f"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="290" />
                    </Border>
                    <TextBlock x:Name="InfoText" Text="拖入 .osu 或点击选择" FontSize="10"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <CheckBox x:Name="FollowCheck" Content="跟随当前谱面" Foreground="{StaticResource Fg}"
                              FontSize="11" IsChecked="True"
                              Checked="FollowCheck_Changed" Unchecked="FollowCheck_Changed" />
                    <TextBlock x:Name="TosuStatus" Text="" Visibility="Collapsed" />
                    <Button Content="选择谱面…" Click="Browse_Click" Padding="8,3" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- settings -->
        <Border Grid.Row="1" Height="46" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="倍速" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Grid Width="64" Margin="5,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RateBox" TextAlignment="Center" VerticalContentAlignment="Center" Text="1.0" Tag="rate" PreviewTextInput="Number_PreviewTextInput"
                             LostFocus="Number_LostFocus" TextChanged="Setting_Changed" />
                    <StackPanel Grid.Column="1">
                        <Button Content="▲" FontSize="5" Height="13" Padding="0" Tag="rate:1" Click="Spin_Click" />
                        <Button Content="▼" FontSize="5" Height="13" Padding="0" Tag="rate:-1" Click="Spin_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="BPM" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Grid Width="64" Margin="5,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BpmBox" TextAlignment="Center" VerticalContentAlignment="Center" Tag="bpm" PreviewTextInput="Number_PreviewTextInput"
                             LostFocus="Number_LostFocus" TextChanged="Setting_Changed" />
                    <StackPanel Grid.Column="1">
                        <Button Content="▲" FontSize="5" Height="13" Padding="0" Tag="bpm:1" Click="Spin_Click" />
                        <Button Content="▼" FontSize="5" Height="13" Padding="0" Tag="bpm:-1" Click="Spin_Click" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="BpmCheck" Content="按BPM" Foreground="{StaticResource Fg}" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,6,0"
                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                <TextBlock x:Name="EffectiveRate" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                           Width="44" FontSize="11" />
                <CheckBox x:Name="PitchCheck" Content="保持音高" Foreground="{StaticResource Fg}" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="True"
                          Checked="Setting_Changed" Unchecked="Setting_Changed" />

                <TextBlock Text="OD" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Grid Width="60" Margin="5,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OdBox" TextAlignment="Center" VerticalContentAlignment="Center" Tag="od" PreviewTextInput="Number_PreviewTextInput"
                             LostFocus="Number_LostFocus" TextChanged="Setting_Changed" />
                    <StackPanel Grid.Column="1">
                        <Button Content="▲" FontSize="5" Height="13" Padding="0" Tag="od:1" Click="Spin_Click" />
                        <Button Content="▼" FontSize="5" Height="13" Padding="0" Tag="od:-1" Click="Spin_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="HP" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Grid Width="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HpBox" TextAlignment="Center" VerticalContentAlignment="Center" Tag="hp" PreviewTextInput="Number_PreviewTextInput"
                             LostFocus="Number_LostFocus" TextChanged="Setting_Changed" />
                    <StackPanel Grid.Column="1">
                        <Button Content="▲" FontSize="5" Height="13" Padding="0" Tag="hp:1" Click="Spin_Click" />
                        <Button Content="▼" FontSize="5" Height="13" Padding="0" Tag="hp:-1" Click="Spin_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- transform -->
        <Border Grid.Row="2" Height="46" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="音符" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="ModeBox" Margin="5,0,12,0" SelectedIndex="0" SelectionChanged="Setting_Changed">
                    <ComboBoxItem Content="不处理" />
                    <ComboBoxItem Content="FULL LN（反键）" />
                    <ComboBoxItem Content="RICE（面转米）" />
                    <ComboBoxItem Content="Release（随机面尾）" />
                </ComboBox>

                <TextBlock Grid.Column="2" x:Name="StrengthLabel" Text="缝隙" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Visibility="Collapsed" />
                <ComboBox Grid.Column="3" x:Name="StrengthBox" Margin="5,0,0,0" SelectedIndex="1"
                          SelectionChanged="Setting_Changed" Visibility="Collapsed">
                    <ComboBoxItem Content="松散（1/2 拍）" />
                    <ComboBoxItem Content="标准（1/4 拍）" />
                    <ComboBoxItem Content="密集（1/8 拍）" />
                    <ComboBoxItem Content="无缝（0 缝）" />
                    <ComboBoxItem Content="自定义…" />
                </ComboBox>

                <StackPanel Grid.Column="4" x:Name="CustomGapPanel" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                    <TextBlock Text="1 /" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBox x:Name="CustomGapBox" Width="44" Margin="4,0" Text="3" TextAlignment="Center"
                             VerticalContentAlignment="Center" PreviewTextInput="Number_PreviewTextInput"
                             LostFocus="CustomGap_LostFocus" TextChanged="Setting_Changed" />
                    <TextBlock Text="拍" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- output folder -->
        <Border Grid.Row="3" Height="46" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="输出目录" Foreground="{StaticResource Muted}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="OutputBox" IsReadOnly="True" FontSize="12"
                         Background="#1e1f22" Foreground="{StaticResource Fg}" Padding="5,3" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="更改…" Click="BrowseOutput_Click" Padding="10,4" />
                <Button Grid.Column="3" Content="默认" Click="ResetOutput_Click" Padding="10,4" Margin="6,0,0,0" />
            </Grid>
        </Border>

        <!-- difficulty -->
        <Border Grid.Row="4" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition x:Name="MsdColumn" Width="0.85*" />
                    <ColumnDefinition Width="1.55*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="星数" Foreground="{StaticResource Muted}" FontSize="10" />
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="StarText" Text="—" Foreground="{StaticResource Accent}"
                           FontSize="20" FontWeight="SemiBold" Margin="0,1,0,0" MinHeight="26" VerticalAlignment="Center" />

                <TextBlock Grid.Row="0" Grid.Column="1" Text="段位" Foreground="{StaticResource Muted}" FontSize="10" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,1,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DanText" Text="—" Foreground="{StaticResource Fg}"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               MinHeight="24" VerticalAlignment="Center" />
                    <TextBlock x:Name="LnText" Text="" Foreground="{StaticResource Accent}"
                               FontSize="11" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="MsdLabel" Text="MSD" Foreground="{StaticResource Muted}" FontSize="10" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="MsdText" Text="—" Foreground="{StaticResource Accent}"
                           FontSize="20" FontWeight="SemiBold" Margin="0,1,0,0" MinHeight="26" VerticalAlignment="Center" />

                <TextBlock Grid.Row="0" Grid.Column="3" Text="键型" Foreground="{StaticResource Muted}" FontSize="10" />
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="PatternText" Text="—"
                           Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" MinHeight="24" VerticalAlignment="Center" Margin="0,1,0,0" />
            </Grid>
        </Border>

        <!-- footer: predicted output path -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,8,0">
                <TextBlock x:Name="OutputPathText" Text="—" Foreground="{StaticResource Fg}" FontSize="11"
                           TextWrapping="Wrap" MaxHeight="30" />
            </Border>
            <Button Grid.Column="1" x:Name="GenerateButton" Content="生成" Click="Generate_Click"
                    Padding="22,6" IsEnabled="False" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>

