<Window x:Class="OsuMapTools.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量倍速"
        Width="460" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TypeBox" AutomationProperties.AutomationId="TypeBox" SelectedIndex="0"
                  Margin="0,0,0,8" SelectionChanged="Type_Changed">
            <ComboBoxItem Content="倍速" />
            <ComboBoxItem Content="BPM" />
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="低值" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LowBox" AutomationProperties.AutomationId="LowBox" Text="1.0" TextAlignment="Center"
                 VerticalContentAlignment="Center" Margin="0,0,4,8" TextChanged="Value_Changed"
                 PreviewTextInput="Number_PreviewTextInput" LostFocus="Box_LostFocus" />
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="▲" FontSize="7" Width="22" Height="14" Padding="0" Tag="low:1" Click="Spin_Click" />
            <Button Content="▼" FontSize="7" Width="22" Height="14" Padding="0" Tag="low:-1" Click="Spin_Click" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="高值" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="HighBox" AutomationProperties.AutomationId="HighBox" Text="1.25" TextAlignment="Center"
                 VerticalContentAlignment="Center" Margin="0,0,4,8" TextChanged="Value_Changed"
                 PreviewTextInput="Number_PreviewTextInput" LostFocus="Box_LostFocus" />
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="▲" FontSize="7" Width="22" Height="14" Padding="0" Tag="high:1" Click="Spin_Click" />
            <Button Content="▼" FontSize="7" Width="22" Height="14" Padding="0" Tag="high:-1" Click="Spin_Click" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="生成步长" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="StepBox" AutomationProperties.AutomationId="StepBox" Text="0.05" TextAlignment="Center"
                 VerticalContentAlignment="Center" Margin="0,0,4,8" TextChanged="Value_Changed"
                 PreviewTextInput="Number_PreviewTextInput" LostFocus="Box_LostFocus" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="方向" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="UpRadio" Content="加速" IsChecked="True" Foreground="{StaticResource Fg}"
                         Margin="0,0,14,0" Checked="Value_Changed" />
            <RadioButton x:Name="DownRadio" Content="减速" Foreground="{StaticResource Fg}" Checked="Value_Changed" />
        </StackPanel>

        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" x:Name="AlignCheck"
                  Content="BPM 自动对齐 0/5 结尾" Foreground="{StaticResource Fg}" Margin="0,0,0,8"
                  Checked="Value_Changed" Unchecked="Value_Changed" />

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" x:Name="PreviewText"
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10"
                   VerticalAlignment="Top" Margin="0,0,0,8" />

        <ProgressBar Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" x:Name="Progress"
                     Height="6" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,8" />
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Padding="16,5" Margin="0,0,8,0" Click="Close_Click" IsCancel="True" />
            <Button x:Name="GenerateButton" AutomationProperties.AutomationId="GenerateButton" Content="批量生成" Padding="18,5" Click="Generate_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
